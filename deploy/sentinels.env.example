# Sentinels secrets — copy to sentinels.env and protect it: chmod 600 sentinels.env
# Fill in only what you use. Never put these values in sentinels.yaml.

# AI (Claude, OpenAI, Gemini, OpenRouter…)
SENTINELS_AI_KEY=

# CrowdSec: cscli bouncers add sentinels
SENTINELS_CROWDSEC_KEY=

# Notifiers
SENTINELS_TELEGRAM_TOKEN=
SENTINELS_SLACK_WEBHOOK=
SENTINELS_DISCORD_WEBHOOK=
SENTINELS_SMTP_USER=
SENTINELS_SMTP_PASSWORD=
SENTINELS_WEBHOOK_URL=
SENTINELS_WEBHOOK_SECRET=

# Databases for the RLS audit (read-only user)
# SENTINELS_DB_EDUCARE=postgres://auditor:password@127.0.0.1:5432/db?sslmode=disable
