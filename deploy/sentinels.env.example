# Segredos do Sentinels — copie para sentinels.env e proteja: chmod 600 sentinels.env
# Só preencha o que usar. Nunca coloque estes valores no sentinels.yaml.

# IA (Claude, OpenAI, Gemini, OpenRouter…)
SENTINELS_AI_KEY=

# CrowdSec: cscli bouncers add sentinels
SENTINELS_CROWDSEC_KEY=

# Notificadores
SENTINELS_TELEGRAM_TOKEN=
SENTINELS_SLACK_WEBHOOK=
SENTINELS_DISCORD_WEBHOOK=
SENTINELS_SMTP_USER=
SENTINELS_SMTP_PASSWORD=
SENTINELS_WEBHOOK_URL=
SENTINELS_WEBHOOK_SECRET=

# Bancos para a auditoria de RLS (usuário somente leitura)
# SENTINELS_DB_EDUCARE=postgres://auditor:senha@127.0.0.1:5432/db?sslmode=disable
